# ==============================================================================
# Reminder App — Змінні оточення (Шаблон конфігурації для розгортання)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Загальні налаштування додатку та середовища
# ------------------------------------------------------------------------------
APP_CONFIG__ENVIRONMENT=local
APP_CONFIG__API__V1_PREFIX=/api/v1
APP_CONFIG__API__CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "http://localhost:8000"]

# ------------------------------------------------------------------------------
# 2. Безпека, JWT та хешування паролів
# ------------------------------------------------------------------------------
APP_CONFIG__AUTH__ACCESS_SECRET_KEY=local-dev-secret-key-min-32-chars-for-reminder-app
APP_CONFIG__AUTH__INTERNAL_TOKEN=local-dev-internal-bot-token-min-32-chars
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_CONFIG__AUTH__BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 3. База даних PostgreSQL 16+
# ------------------------------------------------------------------------------
APP_CONFIG__DB__USER=reminder_user
APP_CONFIG__DB__PASSWORD=reminder_secret_password
APP_CONFIG__DB__NAME=reminder_app
APP_CONFIG__DB__HOST=127.0.0.1
APP_CONFIG__DB__PORT=5434
DB_HOST_PORT=5434
APP_CONFIG__DB__ECHO=0

# Хостовий порт бекенду для Docker Compose
BACKEND_HOST_PORT=8000

# ------------------------------------------------------------------------------
# 4. Redis 7+ (Кеш, черги сповіщень та задачі ARQ)
# ------------------------------------------------------------------------------
APP_CONFIG__REDIS__HOST=127.0.0.1
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__PASSWORD=reminder_redis_password
APP_CONFIG__REDIS__DATABASES__DEFAULT=0
APP_CONFIG__REDIS__DATABASES__TASK=1
APP_CONFIG__REDIS__NOTIFICATION_QUEUE_KEY=queue:notifications:telegram

# ------------------------------------------------------------------------------
# 5. Фоновий воркер ARQ
# ------------------------------------------------------------------------------
APP_CONFIG__ARQ__MAX_JOBS=10
APP_CONFIG__ARQ__JOB_TIMEOUT=300

# ------------------------------------------------------------------------------
# 6. Фінансові сервіси та курси валют (НБУ, Monobank, ПриватБанк)
# ------------------------------------------------------------------------------
APP_CONFIG__FINANCE__NBU_API_URL=https://bank.gov.ua/NBUStatService/v1/statdirectory/exchange?json
APP_CONFIG__FINANCE__MONOBANK_API_URL=https://api.monobank.ua/bank/currency
APP_CONFIG__FINANCE__PRIVATBANK_API_URL=https://api.privatbank.ua/p24api/pubinfo?json&exchange&coursid=5
APP_CONFIG__FINANCE__HTTP_TIMEOUT_SECONDS=10.0
APP_CONFIG__FINANCE__STALE_RATE_HOURS=48

# ------------------------------------------------------------------------------
# 7. Telegram Bot (aiogram 3.x)
# ------------------------------------------------------------------------------
APP_CONFIG__BOT__TOKEN=0000000000:AAH_placeholder_telegram_bot_token
APP_CONFIG__BOT__BACKEND_API_URL=http://backend:8000/api/v1

# ------------------------------------------------------------------------------
# 8. Початкове сідування (Суперадміністратор)
# ------------------------------------------------------------------------------
APP_CONFIG__SEED__SUPERADMIN_USERNAME=super_admin
APP_CONFIG__SEED__SUPERADMIN_PASSWORD=super_admin_password

# ------------------------------------------------------------------------------
# 9. Директорії для логів та резервних копій
# ------------------------------------------------------------------------------
LOGS_DIR=./logs
BACKUPS_DIR=./backups
BACKUP_RETENTION_DAYS=7
