# ==============================================================================
# Reminder App — Файли та каталоги, що ігноруються при збірці Docker образів
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Системи контролю версій (Git)
# ------------------------------------------------------------------------------
**/.git
**/.git*
**/.github
.gitmodules
.gitattributes

# ------------------------------------------------------------------------------
# 2. Змінні оточення, сертифікати та секрети
# ------------------------------------------------------------------------------
**/.env
**/.env.*
!.env.example
!.env.template
**/.envrc
certs/
**/*.pem
**/*.key
**/*.crt
**/*.csr
**/*.cer
**/*.pfx
**/*.p12

# ------------------------------------------------------------------------------
# 3. Редактори коду, IDE та інструменти ШІ
# ------------------------------------------------------------------------------
**/.vscode
**/.idea
**/.cursor
**/.cursorrules
**/*.suo
**/*.sln
**/*.swp
**/.DS_Store
**/Thumbs.db
skills-lock.json
.ai
.gemini

# ------------------------------------------------------------------------------
# 4. Документація, допоміжні хостові скрипти та референсні файли
# ------------------------------------------------------------------------------
docs/
scripts/
README.md
docker-compose*.yml
docker-compose*.yaml
Makefile
example_backend/

# ------------------------------------------------------------------------------
# 5. Постійні томи даних, бекапи та тимчасові каталоги
# ------------------------------------------------------------------------------
backups/
logs/
temp/
tmp/
scratch/
temp_generated_docs/
**/logs
**/backups
**/temp
**/tmp

# ------------------------------------------------------------------------------
# 6. Дампи баз даних, бекапи та архіви
# ------------------------------------------------------------------------------
**/*.db
**/*.sqlite3
**/*.sqlite3-journal
**/*.backup
**/*.dump
**/*.sql
**/*.sql.gz
**/*.pgdump
**/*.psql
**/*.dmp
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.7z
**/*.rar
**/*.gz
**/*.in_progress
**/*.tmp
**/*.temp

# ------------------------------------------------------------------------------
# 7. Артефакти Python та віртуальні середовища
# ------------------------------------------------------------------------------
**/.venv
**/venv
**/env
**/ENV
**/__pycache__
**/*.py[codz]
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 8. Специфічні файли бекенду, непотрібні в продакшен-образі
# ------------------------------------------------------------------------------
backend/tests/
backend/Dockerfile
backend/.dockerignore
backend/README.md
