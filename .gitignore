# ==============================================================================
# Reminder App — Правила ігнорування файлів системою контролю версій Git
# ==============================================================================

# ==============================================================================
# 1. Системні файли операційних систем (Linux, macOS, Windows)
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.swo
*.tmp

# ==============================================================================
# 2. Середовища розробки та редактори коду (IDEs)
# ==============================================================================
# JetBrains (PyCharm тощо)
.idea/
*.iws
*.iml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Інші редактори
*.sublime-project
*.sublime-workspace
.fleet/

# ==============================================================================
# 3. Змінні оточення, сертифікати та секрети
# ==============================================================================
.env
.env.*
.envrc
!.env.example
!**/.env.example
!.env.template
!**/.env.template
!.env.test.example
!**/.env.test.example
certs/*
!certs/.keep
!certs/.gitkeep
*.pem
*.key
*.cert
*.crt
*.csr
*.cer
*.pfx
*.p12

# ==============================================================================
# 4. Інструменти ШІ, кодинг-асистенти та метадані (крім .agents/)
# ==============================================================================
# .agents/ відстежується в git як архітектурна конфігурація
skills-lock.json
.ai
.air
.claude
.codex
.cursor/
.cursorrules
.gemini
.gitnexus
.windsurf

# ==============================================================================
# 5. Логи та моніторинг процесів
# ==============================================================================
*.log
logs/**/*
!logs/**/
!logs/**/.keep
!logs/**/.gitkeep

# ==============================================================================
# 6. Python, віртуальні середовища та компілятори
# ==============================================================================
__pycache__/
*.py[codz]
*$py.class
*.so

# Віртуальні середовища
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.Python
develop-eggs/
eggs/
.eggs/
parts/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
__pypackages__/

# Інструменти перевірки типів та лінтери
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/

# Тестування та покриття коду
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
coverage.json
*.cover
*.py.cover

# ==============================================================================
# 7. Бази даних, кеші, дампи та бекапи
# ==============================================================================
# SQLite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal

# Redis
*.rdb
*.aof
*.aof.manifest
*.aof.bak
*.pid

# Дампи бази даних та бекапи
*.backup
*.dump
*.sql
*.sql.gz
*.pgdump
*.psql
*.dmp
*.in_progress

backups/*
!backups/**/
!backups/.keep
!backups/.gitkeep

# ==============================================================================
# 8. Архіви та тимчасові файли
# ==============================================================================
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
*.gz

temp/
.temp/
tmp/
scratch/
temp_generated_docs/

# ==============================================================================
# 9. Захист файлів-маркерів порожніх директорій (.keep)
# ==============================================================================
!**/.keep
!**/.gitkeep
!logs/**/.keep
!backups/.keep
!scripts/.keep
!backend/**/.keep

# ==============================================================================
# 10. Локальні перевизначення Docker та референсний бекенд
# ==============================================================================
docker-compose.override.yml
docker-compose.override.yaml
.docker/

# Референсний код минулої системи (ігнорується в основному репозиторії)
example_backend/
